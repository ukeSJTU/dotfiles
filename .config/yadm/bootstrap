#!/bin/bash
# Phase 2 of this dotfiles repo's bootstrap. yadm runs this automatically
# right after `yadm clone` (see .config/yadm/preflight.sh for phase 1, which
# gets a fresh Mac to the point where the clone can happen at all). Also
# runnable standalone later via `yadm bootstrap` — e.g. after adding new
# entries to .homebrew/Brewfile.
set -euo pipefail

# This repository intentionally supports Apple Silicon Macs only. Keep this
# guard here too because `yadm bootstrap` can be run without preflight.sh.
if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
  echo "Error: this bootstrap currently supports Apple Silicon Macs only." >&2
  exit 1
fi

# Stabilize commands whose behavior depends on the current directory or XDG
# paths, especially Homebrew, git-lfs, and mise.
cd "$HOME"
export XDG_CONFIG_HOME="$HOME/.config"

BREW_BIN="/opt/homebrew/bin/brew"
if [[ ! -x "$BREW_BIN" ]]; then
  echo "Error: Homebrew is missing from the expected Apple Silicon path: $BREW_BIN" >&2
  exit 1
fi
eval "$("$BREW_BIN" shellenv)"

echo "==> brew bundle (installs missing Brewfile entries without upgrading existing ones)..."
brew bundle --no-upgrade --file="$HOME/.homebrew/Brewfile"

echo "==> git lfs install..."
git lfs install --skip-repo

echo "==> Fixing any insecure zsh completion directories flagged by compaudit..."
COMPAUDIT_STATUS=0
INSECURE_PATHS="$(
  zsh -f -c '
    fpath=(
      "$HOMEBREW_PREFIX/share/zsh/site-functions"
      "$HOMEBREW_PREFIX/share/zsh-completions"
      $fpath
    )
    autoload -Uz compaudit
    compaudit
  ' 2>/dev/null
)" || COMPAUDIT_STATUS=$?

# compaudit returns 1 when it successfully finds insecure paths. Any other
# non-zero status means the audit itself failed and should stop bootstrap.
if [[ "$COMPAUDIT_STATUS" -gt 1 ]]; then
  echo "Error: compaudit failed with status $COMPAUDIT_STATUS." >&2
  exit "$COMPAUDIT_STATUS"
fi

while IFS= read -r insecure_path; do
  [[ -n "$insecure_path" ]] || continue
  chmod g-w,o-w "$insecure_path"
done <<<"$INSECURE_PATHS"

echo "==> mise: installing pinned tool versions from the committed lockfile..."
mise install --locked

cat <<'EOF'

==> Bootstrap complete. Still manual, on purpose:
  - Confirm Chrome is set as the default browser and signed in.
  - Open VS Code once if any extension didn't install cleanly.
  - Sign into OrbStack/Docker if you need containers.
  - Open Karabiner-Elements and approve its background service,
    Accessibility access, and Driver Extension when prompted.
EOF
